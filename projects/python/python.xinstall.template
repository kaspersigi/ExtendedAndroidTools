import itertools
import os
import sys
import typing


INTERPRETER = "<HOST_OUT_DIR>/bin/<PYTHON_BINARY>"
PYTHONPATH = "<ANDROID_OUT_DIR>/lib/python<PYTHON_ABI_VERSION>/site-packages/"
INSTALL_LAYOUT = "--install-layout"


def filter_install_layout(
    args: typing.Sequence[str],
) -> typing.List[str]:
    return [
        arg
        for (prev_arg, arg) in zip(
            itertools.chain([""], args),
            args,
        )
        if arg != INSTALL_LAYOUT
        if prev_arg != INSTALL_LAYOUT
    ]


def main():
    match sys.argv:
        case [binary, "setup.py", "install", *rest]:
            args = [
                INTERPRETER,
                "setup.py",
                "install",
            ] + filter_install_layout(rest)
        case _:
            args = [INTERPRETER] + sys.argv[1:]

    env = os.environ.copy()
    env["PYTHONPATH"] = PYTHONPATH
    # Cross-installation must never discover packages from the build user's
    # ~/.local directory.  Keeping this here also makes local and CI builds
    # behave identically.
    env["PYTHONNOUSERSITE"] = "1"
    os.execve(INTERPRETER, args, env)


if __name__ == "__main__":
    main()
